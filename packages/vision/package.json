{
  "name": "@psp/vision",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Visión en el dispositivo (puertos + MediaPipe + mocks): rostro y malla, recorte de persona, gestos de mano, detección de rostros, métricas de frame, cumplimiento documental y auto-captura.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mediapipe": "./src/adapters/mediapipe.ts",
    "./segmenter": "./src/adapters/segmenter.ts",
    "./gestures": "./src/adapters/gestures.ts",
    "./face-detector": "./src/adapters/face-detector.ts"
  },
  "scripts": { "test": "vitest run", "typecheck": "tsc -p tsconfig.json" },
  "dependencies": { "@psp/contracts": "workspace:*", "@mediapipe/tasks-vision": "0.10.35" },
  "devDependencies": { "typescript": "5.9.3", "vitest": "3.2.7" }
}
