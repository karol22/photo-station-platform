{
  "name": "@psp/station-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Servicio local de la máquina: API de estación (/station/v1) y SSE para el kiosco, DB local, sync con la nube, hardware mock, retención.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "10.1.0",
    "@fastify/static": "8.3.0",
    "@psp/bundler": "workspace:*",
    "@psp/config-engine": "workspace:*",
    "@psp/contracts": "workspace:*",
    "@psp/domain": "workspace:*",
    "@psp/fixtures": "workspace:*",
    "@psp/imaging": "workspace:*",
    "@psp/integrations": "workspace:*",
    "@psp/sqlite": "workspace:*",
    "fastify": "5.12.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
